SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MESTO_ADMIN_LOGIN=mesto.admin
MESTO_ADMIN_PASSWORD_HASH=
MESTO_ADMIN_SESSION_SECRET=
MESTO_USER_SESSION_SECRET=
MESTO_PUBLIC_ORIGIN=https://mesto-city-guide.vercel.app
# Local/test only. Production rejects memory and requires upstash-redis.
MESTO_RATE_LIMIT_PROVIDER=memory
MESTO_RATE_LIMIT_REDIS_URL=
MESTO_RATE_LIMIT_REDIS_TOKEN=
# Optional override. Production may reuse the shared rate-limit Redis above.
MESTO_ADMIN_SESSION_REVOCATION_PROVIDER=
MESTO_ADMIN_SESSION_REDIS_URL=
MESTO_ADMIN_SESSION_REDIS_TOKEN=
# Set to vercel only inside a Vercel Preview/Production Function runtime.
MESTO_CACHE_PURGE_PROVIDER=none
# Vercel enables structured request logs automatically; use 1 for local diagnostics.
MESTO_TELEMETRY_LOGS=0
VK_ID_APP_ID=
# Only confidential VK ID applications require the Service access key.
VK_ID_SERVICE_TOKEN=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
