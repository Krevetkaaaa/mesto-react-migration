SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MESTO_SUPABASE_PROJECT_REF=
# Random 32+ character bearer secret for the protected media reaper endpoint.
CRON_SECRET=
# Required in Vercel and scoped separately as preview or production.
MESTO_RELEASE_TARGET=
MESTO_ADMIN_LOGIN=mesto.admin
MESTO_ADMIN_PASSWORD_HASH=
MESTO_ADMIN_SESSION_SECRET=
MESTO_USER_SESSION_SECRET=
# Local production-like server origin. Override per Vercel Preview/Production environment.
MESTO_PUBLIC_ORIGIN=http://127.0.0.1:4173
# Local/test only. Production rejects memory and requires upstash-redis.
MESTO_RATE_LIMIT_PROVIDER=memory
MESTO_RATE_LIMIT_REDIS_URL=
MESTO_RATE_LIMIT_REDIS_TOKEN=
MESTO_REDIS_NAMESPACE=local
# Local acceptance/load deployment pin: exact 40-hex commit SHA.
MESTO_EXPECTED_PREVIEW_COMMIT_SHA=
# Local acceptance/load provider pin: SHA-256 base64url of the rate-limit and admin Redis endpoint pair.
MESTO_EXPECTED_PREVIEW_REDIS_PROVIDERS_FINGERPRINT=
MESTO_FORBIDDEN_PRODUCTION_REDIS_PROVIDERS_FINGERPRINT=
MESTO_EXPECTED_PREVIEW_SUPABASE_PROJECT_REF=
MESTO_FORBIDDEN_PRODUCTION_SUPABASE_PROJECT_REF=
# Optional override. Production may reuse the shared rate-limit Redis above.
MESTO_ADMIN_SESSION_REVOCATION_PROVIDER=
MESTO_ADMIN_SESSION_REDIS_URL=
MESTO_ADMIN_SESSION_REDIS_TOKEN=
# Set to vercel only inside a Vercel Preview/Production Function runtime.
MESTO_CACHE_PURGE_PROVIDER=none
# Vercel enables structured request logs automatically; use 1 for local diagnostics.
MESTO_TELEMETRY_LOGS=0
VK_ID_APP_ID=
# Only confidential VK ID applications require the Service access key.
VK_ID_SERVICE_TOKEN=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
